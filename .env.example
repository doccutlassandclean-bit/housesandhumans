# Houses & Humans — Phase 1 backend configuration.
# Copy to .env and fill in real values. .env is gitignored.

# development | production. In production every protected /api route fails
# closed with 401 until real authentication is implemented.
NODE_ENV=development

# Port the backend listens on.
PORT=3000

# Open WebUI server (server-side only; the browser never sees this or the key).
OWU_BASE_URL=https://your-open-webui.example
OWU_API_KEY=sk-your-key

# Model id forwarded to Open WebUI.
DEFAULT_MODEL_ID=dd-5e

# Development-only fallback identity when X-User-Id is missing or invalid.
# X-User-Id is spoofable by design and is ignored entirely in production.
DEV_USER_ID=dev

# Optional overrides:
# RATE_LIMIT_PER_MIN=30
# DB_PATH=./housesandhumans.db
